{
  "name": "book-design-types",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "objects/*/*"
  ],
  "scripts": {
    "check": "node tools/validate-workspace.mjs",
    "check:history": "node tools/history.mjs verify",
    "build": "node tools/build.mjs",
